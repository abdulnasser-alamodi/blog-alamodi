---
const { title } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;700&family=Tajawal:wght@300;400;500;700&display=swap" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header class="site-header">
    <div class="header-top">
      <div class="header-meta">مستشار إداري معتمد · PMP</div>
      <div class="site-title">
        <h1>مدوّنة العمودي</h1>
        <p>أعمال · قيادة · إدارة</p>
      </div>
      <div class="header-meta">عبدالناصر العمودي</div>
    </div>
    <nav class="header-nav">
      <a href="/" class="nav-link">الرئيسية</a>
      <a href="/ghashmarah" class="nav-link">غشمرة</a>
      <a href="/blog" class="nav-link">الأعمال</a>
    </nav>
  </header>
  <slot />
  <footer class="site-footer">
    <span>© ٢٠٢٦ عبدالناصر محمد العمودي</span>
    <div class="footer-links">
      <a href="https://alamodi.site">الموقع الشخصي</a>
      <a href="https://alamodi.site/ap">المستشار للأعمال</a>
    </div>
  </footer>
</body>
</html>
