---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  tags?: string[];
}
const { title, description = "منصة معرفية في الأعمال والقيادة والتفاوض وعلم النفس", image, tags = [] } = Astro.props;
const siteTitle = "مدونة العمودي";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === siteTitle ? title : `${title} | ${siteTitle}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  {image && <meta property="og:image" content={image} />}
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;500;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <!-- MASTHEAD -->
  <header class="site-masthead">
    <div class="masthead-top site-wrapper">
      <a href="/" class="site-logo">
        <img src="/images/logo.svg" alt="مدونة العمودي" class="logo-img"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
        <span class="logo-text" style="display:none;">مدونة العمودي</span>
        <span class="logo-tagline">منصة معرفية | عبدالناصر العمودي</span>
      </a>
    </div>
    <nav class="site-nav site-wrapper">
      <a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>الرئيسية</a>
      <a href="/#business">الأعمال</a>
      <a href="/#leadership">القيادة</a>
      <a href="/#negotiation">التفاوض</a>
      <a href="/#psychology">علم النفس</a>
      <a href="/ghashmarah" class={Astro.url.pathname.startsWith('/ghashmarah') ? 'active' : ''}>غشمرة</a>
      <a href="https://alamodiai.site" target="_blank" rel="noopener">الاستشارات</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-content">
      <div class="site-logo">
        <span class="logo-text">مدونة العمودي</span>
        <span class="logo-tagline">منصة معرفية | عبدالناصر العمودي</span>
      </div>
      <p class="footer-about">
        منصة معرفية متخصصة في الأعمال والقيادة والتفاوض وعلم النفس التطبيقي،
        يكتبها عبدالناصر محمد العمودي من واقع تجربة عملية وقراءة نقدية معمّقة.
      </p>
      <a href="https://alamodiai.site" target="_blank" rel="noopener" class="footer-cta">منصة الاستشارات ←</a>
    </div>
    <div class="footer-bottom">
      © {new Date().getFullYear()} <span class="footer-gold">مدونة العمودي</span> — جميع الحقوق محفوظة
    </div>
  </footer>
</body>
</html>
