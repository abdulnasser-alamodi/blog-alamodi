---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("ghashmarah")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="غشمرة — مدوّنة العمودي">
  <div class="ghashmarah-page">
    <header class="section-header">
      <div class="section-label">قسم</div>
      <h1 class="section-title">غشمرة</h1>
      <p class="section-desc">مقالات كوميدية تسلط الضوء على سلبيات اجتماعية — بأسلوب ناقد وعميق</p>
      <div class="divider"></div>
    </header>
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-icon">😤</div>
          <div class="post-body">
            <div class="post-date">
              {post.data.pubDate.toLocaleDateString("ar-SA", { year: "numeric", month: "long", day: "numeric" })}
            </div>
            <h2 class="post-title">
              <a href={`/ghashmarah/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="post-desc">{post.data.description}</p>
            {post.data.tags && (
              <div class="post-tags">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.ghashmarah-page { max-width: 860px; margin: 0 auto; padding: 60px max(24px, 4vw); }
.section-header { text-align: center; margin-bottom: 56px; }
.section-label { font-size: 11px; letter-spacing: 0.2em; color: #A8853A; text-transform: uppercase; font-weight: 700; margin-bottom: 12px; }
.section-title { font-family: "Scheherazade New", serif; font-size: 52px; font-weight: 700; color: #1C1208; margin: 0 0 16px; }
.section-desc { font-size: 15px; color: #7A6E62; line-height: 1.8; margin: 0; }
.divider { width: 60px; height: 2px; background: #A8853A; margin: 24px auto 0; }
.posts-grid { display: flex; flex-direction: column; gap: 0; }
.post-card { display: flex; gap: 24px; padding: 36px 0; border-bottom: 1px solid #D6CCBF; align-items: flex-start; }
.post-icon { font-size: 32px; flex-shrink: 0; margin-top: 4px; }
.post-body { flex: 1; }
.post-date { font-size: 11px; color: #7A6E62; margin-bottom: 8px; letter-spacing: 0.06em; }
.post-title { font-family: "Scheherazade New", serif; font-size: 24px; font-weight: 700; color: #1C1208; margin: 0 0 10px; line-height: 1.5; }
.post-title a { color: inherit; text-decoration: none; }
.post-title a:hover { color: #A8853A; }
.post-desc { font-size: 14px; color: #5C5047; line-height: 1.8; margin: 0 0 14px; }
.post-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.tag { font-size: 11px; color: #A8853A; border: 1px solid #D6CCBF; padding: 3px 10px; }
</style>
