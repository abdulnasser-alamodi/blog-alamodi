---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('ghashmarah');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('ar', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    calendar: 'gregory',
    numberingSystem: 'arab',
  });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <h1 class="post__title">{post.data.title}</h1>
    <p class="post__meta">{formatDate(post.data.pubDate)}</p>
    <div class="post__body">
      <Content />
    </div>
    <p class="back-link"><a href="/">→ العودة للرئيسية</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: 28px 48px;
    max-width: 65ch;
    margin: 0 auto;
  }
  .post__title {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 42px);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .post__meta {
    font-size: 12.5px;
    color: var(--muted);
    margin: 0 0 28px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }
  .post__body {
    font-size: 17px;
    line-height: 1.9;
  }
  .post__body :global(h2),
  .post__body :global(h3) {
    font-family: var(--font-display);
  }
  .post__body :global(p) {
    margin: 0 0 1.4em;
  }
  .back-link {
    margin-top: 36px;
  }
  .back-link a {
    color: var(--accent);
    text-decoration: none;
  }
</style>
