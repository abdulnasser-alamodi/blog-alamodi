---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("ghashmarah");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — غشمرة`}>
  <article class="gh-article">
    <header class="gh-header">
      <div class="gh-label">غشمرة</div>
      <h1 class="gh-title">{post.data.title}</h1>
      <p class="gh-desc">{post.data.description}</p>
      <div class="gh-meta">
        {post.data.pubDate.toLocaleDateString("ar-SA", { year: "numeric", month: "long", day: "numeric" })}
      </div>
      {post.data.tags && (
        <div class="gh-tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="gh-body">
      <Content />
    </div>
    <footer class="gh-footer">
      <a href="/ghashmarah" class="back-link">← العودة إلى غشمرة</a>
    </footer>
  </article>
</BaseLayout>

<style>
.gh-article { max-width: 720px; margin: 0 auto; padding: 60px max(24px, 4vw); }
.gh-header { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid #D6CCBF; }
.gh-label { font-size: 11px; letter-spacing: 0.2em; color: #A8853A; font-weight: 700; text-transform: uppercase; margin-bottom: 16px; }
.gh-title { font-family: "Scheherazade New", serif; font-size: 40px; font-weight: 700; color: #1C1208; line-height: 1.5; margin: 0 0 16px; }
.gh-desc { font-size: 16px; color: #5C5047; line-height: 1.8; margin: 0 0 20px; }
.gh-meta { font-size: 12px; color: #7A6E62; margin-bottom: 16px; }
.gh-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.tag { font-size: 11px; color: #A8853A; border: 1px solid #D6CCBF; padding: 3px 10px; }
.gh-body { font-size: 16px; line-height: 2; color: #2C2318; }
.gh-body h2 { font-family: "Scheherazade New", serif; font-size: 26px; color: #1C1208; margin: 40px 0 16px; }
.gh-body p { margin: 0 0 24px; }
.gh-body strong { color: #1C1208; font-weight: 700; }
.gh-body hr { border: none; border-top: 1px solid #D6CCBF; margin: 36px 0; }
.gh-footer { margin-top: 60px; padding-top: 24px; border-top: 1px solid #D6CCBF; }
.back-link { font-size: 13px; color: #A8853A; font-weight: 600; text-decoration: none; }
.back-link:hover { text-decoration: underline; }
</style>
