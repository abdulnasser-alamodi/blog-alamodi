---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1);

function formatDate(d: Date) {
  return d.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const tagMap: Record<string, string> = {
  'علم النفس': '#psychology',
  'الأعمال': '#business',
  'القيادة': '#leadership',
  'التفاوض': '#negotiation',
  'تسويق': '#business',
  'اقتصاد': '#business',
  'تنمية ذاتية': '#psychology',
  'ثقافة مؤسسية': '#business',
  'إدارة': '#business',
};
---
<BaseLayout title="مدونة العمودي - منصة معرفية">
  <div class="site-wrapper">
    <div class="page-grid">
      <div>
        {featured && (
          <article class="featured">
            {featured.data.image && (
              <div class="featured-image">
                <img src={featured.data.image} alt={featured.data.title} />
              </div>
            )}
            <div class="featured-text">
              <h2 class="featured-title">
                <a href={`/blog/${featured.id}`}>{featured.data.title}</a>
              </h2>
              <p class="featured-excerpt">{featured.data.description}</p>
              <div class="featured-meta">{featured.data.author} · {formatDate(featured.data.pubDate)}</div>
            </div>
          </article>
        )}

        {rest.length > 0 && (
          <section>
            <h2 class="posts-heading">مقالات أخرى</h2>
            <ul class="post-list">
              {rest.map(post => (
                <li class="post-list-item">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  <div class="post-date">{formatDate(post.data.pubDate)}</div>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-card-title">المواضيع</h3>
          <ul class="topics-list">
            {[...new Set(posts.flatMap(p => p.data.tags))].map(tag => (
              <li><a href={tagMap[tag] ?? '#'}>{tag}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
