---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1);

function formatDate(d: Date) {
  return d.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const tagMap: Record<string, string> = {
  'علم النفس': '#psychology',
  'الأعمال': '#business',
  'القيادة': '#leadership',
  'التفاوض': '#negotiation',
  'تسويق': '#business',
  'اقتصاد': '#business',
  'تنمية ذاتية': '#psychology',
  'ثقافة مؤسسية': '#business',
  'إدارة': '#business',
};
---
<BaseLayout title="مدونة العمودي - منصة معرفية">
  <div class="site-wrapper">
    <div class="page-grid">
      <!-- MAIN CONTENT -->
      <main>
        <!-- FEATURED -->
        {featured && (
          <article class="featured-article">
            <div class="featured-image-wrap">
              {featured.data.image ? (
                <img src={featured.data.image} alt={featured.data.title}
                     onerror="this.parentElement.innerHTML='<div class=featured-image-placeholder><span>✦</span></div>'" />
              ) : (
                <div class="featured-image-placeholder"><span>✦</span></div>
              )}
              <span class="featured-badge">مقال مختار</span>
            </div>
            <div class="featured-content">
              <div class="featured-category">{featured.data.tags?.[0] ?? 'مقال'}</div>
              <h1 class="featured-title">
                <a href={`/blog/${featured.id}`}>{featured.data.title}</a>
              </h1>
              <p class="featured-excerpt">{featured.data.description}</p>
              <div class="article-meta">
                <span class="meta-author">{featured.data.author}</span>
                <span class="meta-sep">·</span>
                <span>{formatDate(featured.data.pubDate)}</span>
                <span class="meta-sep">·</span>
                <span>وقت القراءة: دقيقتان</span>
              </div>
            </div>
          </article>
        )}

        <!-- MORE ARTICLES -->
        {rest.length > 0 && (
          <section>
            <div class="section-header">
              <h2 class="section-title">مقالات حديثة</h2>
              <span class="section-line"></span>
            </div>
            <div class="articles-grid">
              {rest.map(post => (
                <article class="article-card">
                  <div class="card-image">
                    {post.data.image ? (
                      <img src={post.data.image} alt={post.data.title}
                           onerror="this.parentElement.innerHTML='<div class=card-image-placeholder>✦</div>'" />
                    ) : (
                      <div class="card-image-placeholder">✦</div>
                    )}
                  </div>
                  <div class="card-body">
                    <div class="card-category">{post.data.tags?.[0] ?? 'مقال'}</div>
                    <h2 class="card-title">
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h2>
                    <p class="card-excerpt">{post.data.description}</p>
                    <div class="card-meta">
                      <span>{post.data.author}</span>
                      <span>·</span>
                      <span>{formatDate(post.data.pubDate)}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <!-- About -->
        <div class="sidebar-widget about-widget">
          <div class="widget-header">عن الكاتب</div>
          <div class="widget-body">
            <div class="about-avatar">ع</div>
            <div class="about-name">عبدالناصر محمد العمودي</div>
            <p class="about-bio">
              مستشار في الأعمال والقيادة، يكتب في التفاوض وعلم النفس التطبيقي
              من واقع تجربة عملية ميدانية وقراءة نقدية معمّقة.
            </p>
          </div>
        </div>

        <!-- Ad -->
        <div class="sidebar-widget ad-widget">
          <div class="widget-header">استشاراتي</div>
          <div class="widget-body">
            <div class="ad-eyebrow">منصة الاستشارات الذكية</div>
            <div class="ad-title">الذكاء الاصطناعي في خدمة أعمالك</div>
            <p class="ad-desc">
              حلول استشارية متكاملة بتقنيات الذكاء الاصطناعي لتطوير مؤسستك وتحقيق أهدافك الاستراتيجية.
            </p>
            <a href="https://alamodiai.site" target="_blank" rel="noopener" class="ad-cta">
              اكتشف الآن
            </a>
          </div>
        </div>

        <!-- Tags -->
        {posts.flatMap(p => p.data.tags).filter((v, i, a) => a.indexOf(v) === i).length > 0 && (
          <div class="sidebar-widget">
            <div class="widget-header">المواضيع</div>
            <div class="widget-body">
              <div class="tags-cloud">
                {[...new Set(posts.flatMap(p => p.data.tags))].map(tag => (
                  <a href={tagMap[tag] ?? '#'} class="tag">{tag}</a>
                ))}
              </div>
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
