---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;

function formatDate(date: Date) {
  return date.toLocaleDateString('ar', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    calendar: 'gregory',
    numberingSystem: 'arab',
  });
}
---

<BaseLayout
  title="مدونة المستشار"
  description="رؤى إدارية، ونبضات أدبية، لرحلة تتجاوز مألوف الحياة"
>
  <div class="home-grid">
    <div class="main-col">
      {
        featured && (
          <article class="featured">
            {featured.data.category && <span class="category">{featured.data.category}</span>}
            <h1 class="featured__title">
              <a href={`/${featured.id}`}>{featured.data.title}</a>
            </h1>
            <p class="featured__desc">{featured.data.description}</p>
            <p class="meta">
              {formatDate(featured.data.pubDate)}
              {featured.data.readTime ? ` · ${featured.data.readTime} دقائق قراءة` : ''}
              {' · '}
              <a class="read-link" href={`/${featured.id}`}>اقرأ المقال ←</a>
            </p>
          </article>
        )
      }

      <ul class="post-list">
        {
          rest.map((post) => (
            <li class="post-item">
              {post.data.category && <span class="category">{post.data.category}</span>}
              <h2 class="post-item__title">
                <a href={`/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="post-item__desc">{post.data.description}</p>
              <p class="meta">
                {formatDate(post.data.pubDate)}
                {' · '}
                <a class="read-link" href={`/${post.id}`}>اقرأ →</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="sidebar">
      <div class="sidebar-box about-box">
        <h3>مدونة المستشار</h3>
        <p>رؤى إدارية، ونبضات أدبية، لرحلة تتجاوز مألوف الحياة.</p>
        <a href="https://alamodi.site/advisory">← زيارة الموقع الاستشاري</a>
      </div>

      <div class="sidebar-box ghashmarah-box">
        <h3>غشمرة</h3>
        <hr />
        <p>مقالات ساخرة</p>
        <a href="/ghashmarah">كل مقالات غشمرة ←</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .home-grid {
    display: flex;
    gap: 36px;
    align-items: flex-start;
    padding-block: 28px 48px;
  }
  .main-col {
    flex: 1 1 auto;
    min-width: 0;
  }
  .sidebar {
    flex: 0 0 280px;
    width: 280px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  @media (max-width: 820px) {
    .home-grid {
      flex-direction: column;
    }
    .sidebar {
      width: 100%;
      flex: 1 1 auto;
    }
  }

  .category {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .featured {
    border-bottom: 1px solid var(--border);
    padding-bottom: 28px;
    margin-bottom: 28px;
  }
  .featured__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .featured__title a {
    color: var(--fg);
    text-decoration: none;
  }
  .featured__desc {
    font-size: 15.5px;
    color: var(--muted);
    max-width: 55ch;
    margin: 0 0 12px;
  }
  .meta {
    font-size: 12.5px;
    color: var(--muted);
    margin: 0;
  }
  .read-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-item {
    border-bottom: 1px solid var(--border);
    padding-block: 22px;
  }
  .post-item:last-child {
    border-bottom: none;
  }
  .post-item__title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .post-item__title a {
    color: var(--fg);
    text-decoration: none;
  }
  .post-item__desc {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .sidebar-box {
    box-sizing: border-box;
  }
  .about-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 16px;
  }
  .about-box h3 {
    font-family: var(--font-display);
    font-size: 17px;
    margin: 0 0 8px;
  }
  .about-box p {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0 0 10px;
  }
  .about-box a {
    color: var(--accent);
    text-decoration: none;
    font-size: 13px;
  }

  .ghashmarah-box {
    background: #000000;
    padding: 18px;
    margin-top: 20px;
    text-align: center;
  }
  .ghashmarah-box h3 {
    color: #fff;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    margin: 0;
  }
  .ghashmarah-box hr {
    width: 40px;
    height: 1px;
    background: var(--accent);
    border: none;
    margin: 10px auto;
  }
  .ghashmarah-box p {
    color: #b9b9b9;
    font-size: 12px;
    margin: 0 0 12px;
  }
  .ghashmarah-box a {
    color: var(--accent);
    font-size: 12px;
    text-decoration: none;
  }
</style>
