---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}>

  <!-- HERO -->
  <div class="article-hero">
    <div class="site-wrapper">
      <div class="hero-category">{post.data.tags?.join(' · ') ?? 'مقال'}</div>
      <h1 class="hero-title">{post.data.title}</h1>
      {post.data.description && <p class="hero-description">{post.data.description}</p>}
      <div class="hero-meta">
        <span class="hero-author">{post.data.author}</span>
        <span>·</span>
        <span>{formatDate(post.data.pubDate)}</span>
        <span>·</span>
        <span>وقت القراءة: دقيقتان</span>
      </div>
    </div>
  </div>

  <!-- COVER IMAGE -->
  {post.data.image && (
    <img src={post.data.image} alt={post.data.title} class="article-cover"
         onerror="this.style.display='none'" />
  )}

  <!-- BODY -->
  <div class="article-layout site-wrapper">
    <article class="article-content">
      <div class="article-body">
        <Content />
      </div>

      <!-- SHARE -->
      <div class="share-bar">
        <span class="share-label">شارك المقال:</span>
        <a class="share-btn"
           href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent('https://blog.alamodi.site/blog/' + post.id)}`}
           target="_blank" rel="noopener">
          𝕏 تويتر
        </a>
        <a class="share-btn"
           href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' - ' + 'https://blog.alamodi.site/blog/' + post.id)}`}
           target="_blank" rel="noopener">
          واتساب
        </a>
      </div>
    </article>

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-widget ad-widget">
        <div class="widget-header">استشاراتي</div>
        <div class="widget-body">
          <div class="ad-eyebrow">منصة الاستشارات الذكية</div>
          <div class="ad-title">الذكاء الاصطناعي في خدمة أعمالك</div>
          <p class="ad-desc">
            حلول استشارية متكاملة بتقنيات الذكاء الاصطناعي لتطوير مؤسستك.
          </p>
          <a href="https://alamodiai.site" target="_blank" rel="noopener" class="ad-cta">
            اكتشف الآن
          </a>
        </div>
      </div>

      <div class="sidebar-widget">
        <div class="widget-header">عن الكاتب</div>
        <div class="widget-body" style="text-align:center;">
          <div class="about-avatar" style="margin:0 auto 0.8rem;">ع</div>
          <div class="about-name">عبدالناصر محمد العمودي</div>
          <p class="about-bio">مستشار في الأعمال والقيادة والتفاوض.</p>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
